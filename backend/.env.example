# Gemma via any OpenAI-compatible API. Default is Google AI Studio:
#   key from https://aistudio.google.com/apikey
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_ACCESS_KEY=
# Gemma model id, e.g. gemma-3-27b-it. `npm run models` lists the ones your key can use.
MODEL_ID=

# Optional: raises GitHub rate limits and allows private repos you can read.
GITHUB_TOKEN=

# Comma-separated origins allowed to call the API (frontend URL). Empty = allow all.
CORS_ORIGINS=
PORT=8787

# Dev only: 1 = return a canned diagnosis without calling the model (UI testing).
LLM_MOCK=0
