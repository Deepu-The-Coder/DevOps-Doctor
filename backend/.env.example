# DigitalOcean serverless inference (OpenAI-compatible)
MODEL_ACCESS_KEY=
MODEL_BASE_URL=https://inference.do-ai.run/v1
# Run `npm run models` to list the exact Gemma 4 model id available to your key.
MODEL_ID=

# Optional: raises GitHub rate limits and allows private repos you can read.
GITHUB_TOKEN=

# Comma-separated origins allowed to call the API (frontend URL). Empty = allow all.
CORS_ORIGINS=
PORT=8787

# Dev only: 1 = return a canned diagnosis without calling the model (UI testing).
LLM_MOCK=0
