# Gemma via any OpenAI-compatible API. Default is Google AI Studio:
#   key from https://aistudio.google.com/apikey
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_ACCESS_KEY=
# Gemma model id, e.g. gemma-3-27b-it. `npm run models` lists the ones your key can use.
MODEL_ID=

# Optional: raises GitHub rate limits and allows private repos you can read.
GITHUB_TOKEN=

# Comma-separated origins allowed to call the API (frontend URL). Empty = allow all.
CORS_ORIGINS=
PORT=8787

# Dev only: 1 = return a canned diagnosis without calling the model (UI testing).
LLM_MOCK=0

# "Sign in with GitHub" (optional). Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Scopes requested at sign-in. "repo" is needed to read private repos (GitHub has no read-only variant).
GITHUB_OAUTH_SCOPE=read:user repo
# In production: the site's public URL, and COOKIE_SECURE=1 when served over HTTPS.
PUBLIC_URL=
COOKIE_SECURE=0
